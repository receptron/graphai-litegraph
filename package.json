    "core-js": "^3.51.0",
    "firebase": "^13",
    "graphai": "^2.0.18",
    "litegraph.js": "^0.7.18",
    "pinia": "^4.1.0",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-router": "^5.5.1",
    "yaml": "^2.9.1"
